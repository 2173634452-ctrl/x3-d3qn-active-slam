# Linux host paths; copy to .env and edit before use.
ASLAM_RESULTS_ROOT=/absolute/path/to/aslam-results
# Existing X3 project providing worlds/assets, third_party/x3-robodog2 and Vocabulary.
ASLAM_ASSETS_ROOT=/absolute/path/to/x3_slam
ASLAM_IMAGE=x3-aslam:local
ASLAM_GPU_DEVICE=nvidia.com/gpu=0
ASLAM_CPUS=8
ASLAM_MEMORY=16g
